# ============================================================
# si'se ダッシュボード 環境変数
# Vercel Dashboard > Settings > Environment Variables に設定する。
# ローカルの scripts/dev-server.mjs は .env.local / .env も読み込む。
# 詳細は RUNBOOK.md「1. 環境変数」を参照。
# ============================================================

# ============================================
# Supabase（必須）
# ============================================
# Supabaseプロジェクトの Settings > API で取得
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ============================================
# スタッフトークン署名（HMAC-SHA256・必須）
# ============================================
# スタッフ URL (?v=<token>) と管理者セッションの署名に使う秘密鍵。
# 値を変更すると発行済みの全スタッフ URL が無効化される（再発行が必要）。
#   openssl rand -hex 32
SISE_AUTH_SECRET=YOUR_32_BYTE_RANDOM_SECRET_HERE

# 1世代前のキー（無停止ローテーション用、任意。RUNBOOK §4）
# SISE_AUTH_SECRET_PREV=PREVIOUS_SECRET_HERE

# 旧形式（署名なし base64）のスタッフ URL を受理するか。全員の URL を再発行したら false に。
ALLOW_LEGACY_TOKENS=true

# ============================================
# 管理者ログイン（HttpOnly cookie + bcrypt）
# ============================================
# true にすると URL 無しのアクセスで管理者ログインが必要になる（本番は true を推奨）
REQUIRE_ADMIN_AUTH=false

# 管理者パスワードの bcrypt ハッシュ。生成: node scripts/gen-admin-hash.js
SISE_ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH_HERE

# ============================================
# SalonOne 分析API（売上・インセンティブ・目標のデータ元）
# ============================================
# SalonOne のブランド選択画面 >「API連携」で発行したアクセスキー（ユーザー認証: 必須にしない）。
# 個人情報は「含めない」でよい（施術ツールのカウンセリングでお名前も出したい時・フォームの回答と予約をお名前で結びつけたい時だけ「含める」。docs/COUNSELING.md）。
# 未設定ならデモデータで表示する。キーはサーバーだけで使い、ブラウザには出さない。
SALONONE_API_KEY=
# API のベース URL（既定: https://salonone.net/api/analytics/v1。通常は設定不要）
# SALONONE_API_BASE_URL=https://salonone.net/api/analytics/v1
# エンドポイントのパスの上書き（JSON。通常は設定不要）。docs/SALONONE.md §2 を参照
# SALONONE_API_ENDPOINTS={"receptions":"/marketing/reception-history"}
# 1分あたりの呼び出しの上限（既定 55。SalonOne でキーの上限を上げてもらった時だけ）
# SALONONE_RATE_LIMIT_PER_MINUTE=55

# ============================================
# カウンセリングフォーム（Google フォームの回答を返す GAS・フォームを使う店舗だけ・任意）
# ============================================
# 設定 > カウンセリングフォーム で保存するのが基本。こちらは保存が無い時に使う。手順は docs/COUNSELING.md
# COUNSELING_GAS_URL=https://script.google.com/macros/s/xxxxx/exec
# GAS のスクリプト プロパティ DASHBOARD_TOKEN と同じ合言葉
# COUNSELING_GAS_TOKEN=

# ============================================
# Claude API（施術ツールの AI 姿勢アドバイス・マンダラの AI レビュー・任意）
# ============================================
# Anthropic Console で取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# マンダラの AI のモデル（任意。既定 claude-sonnet-4-6）
# MANDALA_AI_MODEL=claude-sonnet-4-6

# ============================================
# 旧マンダラツールからの移行（scripts/import-mandala-tool.mjs を手元で動かす時だけ）
# ============================================
# MANDALA_SUPABASE_URL=https://yyyyy.supabase.co
# MANDALA_SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# CORS制限（任意）
# ============================================
# ALLOWED_ORIGIN=https://your-app.vercel.app
