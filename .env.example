# Square API Configuration
# Set these in Vercel Dashboard > Settings > Environment Variables

# ============================================
# 方法1: 単一店舗（既存の設定方法）
# ============================================
SQUARE_ACCESS_TOKEN=YOUR_SQUARE_ACCESS_TOKEN
SQUARE_LOCATION_ID=YOUR_LOCATION_ID
SQUARE_ENVIRONMENT=production
SQUARE_STORE_NAME=メイン店舗
SQUARE_DEFAULT_MONTHLY_PRICE=10000

# ============================================
# 方法2: 複数店舗（5店舗の例）
# 各店舗に番号を振って設定
# ============================================

# --- 店舗1 ---
SQUARE_STORE_1_NAME=新宿店
SQUARE_STORE_1_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_1_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_1_ENVIRONMENT=production

# --- 店舗2 ---
SQUARE_STORE_2_NAME=渋谷店
SQUARE_STORE_2_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_2_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_2_ENVIRONMENT=production

# --- 店舗3 ---
SQUARE_STORE_3_NAME=池袋店
SQUARE_STORE_3_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_3_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_3_ENVIRONMENT=production

# --- 店舗4 ---
SQUARE_STORE_4_NAME=横浜店
SQUARE_STORE_4_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_4_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_4_ENVIRONMENT=production

# --- 店舗5 ---
SQUARE_STORE_5_NAME=大宮店
SQUARE_STORE_5_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_5_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_5_ENVIRONMENT=production

# ============================================
# 方法3: 別アカウントのデータを統合表示
# 1つの店舗に、別のSquareアカウントのデータを統合する場合
# ============================================
# 例: 店舗2（本厚木店）に、大和店アカウント内の本厚木店ロケーションのデータを統合
#
# SQUARE_STORE_1_NAME=大和店
# SQUARE_STORE_1_ACCESS_TOKEN=EAAAxxxx...（大和店のトークン）
# SQUARE_STORE_1_LOCATION_ID=LXXXX1（大和店のロケーションID）
# SQUARE_STORE_1_ENVIRONMENT=production
#
# SQUARE_STORE_2_NAME=本厚木店
# SQUARE_STORE_2_ACCESS_TOKEN=EAAAyyyy...（本厚木店の新アカウントのトークン）
# SQUARE_STORE_2_LOCATION_ID=LXXXX2（本厚木店の新ロケーションID）
# SQUARE_STORE_2_ENVIRONMENT=production
# SQUARE_STORE_2_EXTRA_1_ACCESS_TOKEN=EAAAxxxx...（大和店のトークン）
# SQUARE_STORE_2_EXTRA_1_LOCATION_ID=LXXXX3（大和店内の本厚木店ロケーションID）

# ============================================
# Meta (Facebook/Instagram) 広告API
# ============================================
# Meta Business Suiteで取得
# https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN
META_AD_ACCOUNT_ID=YOUR_AD_ACCOUNT_ID
# META_API_VERSION=v21.0

# ============================================
# TikTok 広告API
# ============================================
# TikTok for Business開発者ポータルで取得
# https://business-api.tiktok.com/portal/docs
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_ACCESS_TOKEN
TIKTOK_ADVERTISER_ID=YOUR_ADVERTISER_ID

# ============================================
# LINE Messaging API（各店舗ごと）
# ============================================
# LINE Developersコンソールで各店舗のMessaging APIチャネルを作成し取得
# https://developers.line.biz/

# --- 店舗1 ---
LINE_STORE_1_NAME=新宿店
LINE_STORE_1_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_STORE_1_SECRET=YOUR_LINE_CHANNEL_SECRET

# --- 店舗2 ---
LINE_STORE_2_NAME=渋谷店
LINE_STORE_2_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_STORE_2_SECRET=YOUR_LINE_CHANNEL_SECRET

# --- 店舗3 ---
# LINE_STORE_3_NAME=池袋店
# LINE_STORE_3_ACCESS_TOKEN=...
# LINE_STORE_3_SECRET=...

# Webhook URL（各店舗ごとにLINE Developersで設定）:
#   https://<your-domain>/api/line/webhook?store=1
#   https://<your-domain>/api/line/webhook?store=2

# GAS Webhook URL（LINE受信メッセージをGASに転送する場合）
# GAS_WEBHOOK_URL=https://script.google.com/macros/s/xxx/exec

# ============================================
# Claude API（姿勢分析アドバイス生成）
# ============================================
# Anthropic Console で取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ============================================
# Supabase（GAS→Supabase段階移行）
# ============================================
# Supabaseプロジェクトの Settings > API で取得
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ============================================
# CORS制限（任意）
# ============================================
# 本番デプロイ時にAPIアクセスを自サイトのみに制限する場合
# ALLOWED_ORIGIN=https://your-app.vercel.app

# ============================================
# スタッフトークン署名（HMAC-SHA256）
# ============================================
# スタッフ URL (?v=<token>) の tamper-proof 化に使用する秘密鍵。
# 値を変更すると発行済みの全スタッフ URL が無効化される（再発行が必要）。
# 生成コマンド例:
#   openssl rand -hex 32
# 本番では必ず設定すること（未設定だと空鍵で署名される=実質無保護）。
SISE_AUTH_SECRET=YOUR_32_BYTE_RANDOM_SECRET_HERE

# 旧形式（署名なし base64 トークン）の受理を許可するか。
# 移行期間中は true のままにし、全スタッフ URL を再発行した後で false に
# 切り替えて古い URL をハード無効化する。
# 既定: true（未設定時も true として扱う）
ALLOW_LEGACY_TOKENS=true

# ============================================
# 管理者ログイン (HttpOnly cookie + bcrypt)
# ============================================
# 管理者モード（URL-less アクセス）でログインを必須化するフラグ。
# 既定: false（未設定 / 'true' 以外のどれでも OFF）
# 段階導入手順:
#   1. このコミットをデプロイ（REQUIRE_ADMIN_AUTH=false のまま）
#   2. SISE_ADMIN_PASSWORD_HASH を下記コマンドで生成して設定
#   3. ダッシュボードにログイン画面が表示されるかテスト
#   4. 問題なければ REQUIRE_ADMIN_AUTH=true に切替
REQUIRE_ADMIN_AUTH=false

# 管理者パスワードの bcrypt ハッシュ。以下のコマンドで生成:
#   node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
# 生成された $2b$10$... 形式の文字列をそのまま設定する。
# パスワード変更したい時はコマンドを再実行して環境変数を書き換えるだけ。
SISE_ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH_HERE
