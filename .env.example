# Square API Configuration
# Set these in Vercel Dashboard > Settings > Environment Variables

# ============================================
# 方法1: 単一店舗（既存の設定方法）
# ============================================
SQUARE_ACCESS_TOKEN=YOUR_SQUARE_ACCESS_TOKEN
SQUARE_LOCATION_ID=YOUR_LOCATION_ID
SQUARE_ENVIRONMENT=production
SQUARE_STORE_NAME=メイン店舗
SQUARE_DEFAULT_MONTHLY_PRICE=10000

# ============================================
# 方法2: 複数店舗（5店舗の例）
# 各店舗に番号を振って設定
# ============================================

# --- 店舗1 ---
SQUARE_STORE_1_NAME=新宿店
SQUARE_STORE_1_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_1_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_1_ENVIRONMENT=production

# --- 店舗2 ---
SQUARE_STORE_2_NAME=渋谷店
SQUARE_STORE_2_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_2_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_2_ENVIRONMENT=production

# --- 店舗3 ---
SQUARE_STORE_3_NAME=池袋店
SQUARE_STORE_3_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_3_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_3_ENVIRONMENT=production

# --- 店舗4 ---
SQUARE_STORE_4_NAME=横浜店
SQUARE_STORE_4_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_4_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_4_ENVIRONMENT=production

# --- 店舗5 ---
SQUARE_STORE_5_NAME=大宮店
SQUARE_STORE_5_ACCESS_TOKEN=EAAAl...（本番トークン）
SQUARE_STORE_5_LOCATION_ID=L...（ロケーションID）
SQUARE_STORE_5_ENVIRONMENT=production

# ============================================
# 方法3: 別アカウントのデータを統合表示
# 1つの店舗に、別のSquareアカウントのデータを統合する場合
# ============================================
# 例: 店舗2（本厚木店）に、大和店アカウント内の本厚木店ロケーションのデータを統合
#
# SQUARE_STORE_1_NAME=大和店
# SQUARE_STORE_1_ACCESS_TOKEN=EAAAxxxx...（大和店のトークン）
# SQUARE_STORE_1_LOCATION_ID=LXXXX1（大和店のロケーションID）
# SQUARE_STORE_1_ENVIRONMENT=production
#
# SQUARE_STORE_2_NAME=本厚木店
# SQUARE_STORE_2_ACCESS_TOKEN=EAAAyyyy...（本厚木店の新アカウントのトークン）
# SQUARE_STORE_2_LOCATION_ID=LXXXX2（本厚木店の新ロケーションID）
# SQUARE_STORE_2_ENVIRONMENT=production
# SQUARE_STORE_2_EXTRA_1_ACCESS_TOKEN=EAAAxxxx...（大和店のトークン）
# SQUARE_STORE_2_EXTRA_1_LOCATION_ID=LXXXX3（大和店内の本厚木店ロケーションID）

# ============================================
# CORS制限（任意）
# ============================================
# 本番デプロイ時にAPIアクセスを自サイトのみに制限する場合
# ALLOWED_ORIGIN=https://your-app.vercel.app
