{
  "name": "sise-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev:local": "node scripts/dev-server.mjs --mock-db",
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "test": "node --test 'test/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "bcryptjs": "^3.0.3",
    "esbuild": "0.28.2",
    "html2canvas": "1.4.1",
    "lucide": "1.58.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  },
  "engines": {
    "node": ">=20"
  }
}
