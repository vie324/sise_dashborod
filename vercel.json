{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "crons": [
    { "path": "/api/salonone?action=cron", "schedule": "30 14 * * *" }
  ],
  "functions": {
    "api/salonone/index.js": { "maxDuration": 60 },
    "api/db/index.js": { "maxDuration": 30 },
    "api/mandala/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/db", "destination": "/api/db" },
    { "source": "/api/salonone", "destination": "/api/salonone" },
    { "source": "/api/claude/advice", "destination": "/api/claude/advice" },
    { "source": "/api/mandala", "destination": "/api/mandala" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
