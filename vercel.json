{
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/square/config", "destination": "/api/square/config" },
    { "source": "/api/square/:path*", "destination": "/api/square/proxy?path=:path*" },
    { "source": "/api/meta/config", "destination": "/api/meta/config" },
    { "source": "/api/meta/:path*", "destination": "/api/meta/proxy?path=:path*" },
    { "source": "/api/tiktok/config", "destination": "/api/tiktok/config" },
    { "source": "/api/tiktok/:path*", "destination": "/api/tiktok/proxy?path=:path*" },
    { "source": "/api/line/config", "destination": "/api/line/config" },
    { "source": "/api/line/webhook", "destination": "/api/line/webhook" },
    { "source": "/api/line/:path*", "destination": "/api/line/proxy?path=:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
